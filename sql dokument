DELIMITER //
CREATE PROCEDURE dodaj_postolje_najboljem (IN p_sezona INT)
BEGIN
    DECLARE v_vozac INT;

    SELECT id_vozac
    INTO v_vozac
    FROM poredak
    WHERE id_sezona = p_sezona
    ORDER BY bodovi DESC
    LIMIT 1;

    UPDATE poredak
    SET postolja = postolja + 1
    WHERE id_vozac = v_vozac
      AND id_sezona = p_sezona;
END //
DELIMITER ;

