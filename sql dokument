#DROP DATABASE formula;
CREATE DATABASE formula;

USE formula;

-- 1. TIM

CREATE TABLE tim (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL UNIQUE,
    baza VARCHAR(100),
    budzet DECIMAL(15,2) NOT NULL DEFAULT 0
);

-- 2. BOLID

CREATE TABLE bolid (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    model VARCHAR(100) NOT NULL,
    godina INT NOT NULL,
    motor VARCHAR(100),
    sasija VARCHAR(100),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 3. VOZAČ

CREATE TABLE vozac (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    ime VARCHAR(100) NOT NULL,
    prezime VARCHAR(100) NOT NULL,
    broj INT NOT NULL,
    nacionalnost VARCHAR(100),
    datum_rodjenja DATE,
    slika LONGBLOB,
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT uniq_broj_tim UNIQUE(tim_id, broj)
);

-- 4. STAZA

CREATE TABLE staza (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL UNIQUE,
    drzava VARCHAR(100),
    duljina_km DECIMAL(5,2),
    broj_krugova INT CHECK (broj_krugova > 0)
);

-- 5. UTRKA

CREATE TABLE utrka (
    id INT AUTO_INCREMENT PRIMARY KEY,
    staza_id INT NOT NULL,
    sezona YEAR NOT NULL,
    datum DATE,
    FOREIGN KEY (staza_id) REFERENCES staza(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 6. SUDJELOVANJE 
#drop table sudjelovanje;
CREATE TABLE sudjelovanje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    utrka_id INT NOT NULL,
    vozac_id INT NOT NULL,
    bolid_id INT NOT NULL,
    FOREIGN KEY (utrka_id) REFERENCES utrka(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (vozac_id) REFERENCES vozac(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (bolid_id) REFERENCES bolid(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT uniq_vozac UNIQUE(utrka_id, vozac_id)#,
#CONSTRAINT uniq_bolid UNIQUE(utrka_id, bolid_id)
);

-- 7. REZULTAT

CREATE TABLE rezultat (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    pozicija INT CHECK (pozicija > 0),
    bodovi INT CHECK (bodovi >= 0),
    vrijeme VARCHAR(50),
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 8. STRATEGIJA

CREATE TABLE strategija (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    broj_ulazaka_boks INT CHECK (broj_ulazaka_boks >= 0),
    tipovi_guma VARCHAR(100),
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 9. KAZNA

CREATE TABLE kazna (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    opis TEXT,
    tip_kazne VARCHAR(100),
    sekunde DECIMAL(4,1) CHECK (sekunde >= 0),
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 10. SPONZOR

CREATE TABLE sponzor (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL,
    tip VARCHAR(100)
);

-- 11. UGOVOR 

CREATE TABLE ugovor (
    tim_id INT NOT NULL,
    sponzor_id INT NOT NULL,
    godina_od YEAR,
    godina_do YEAR,
    vrijednost DECIMAL(15,2) CHECK (vrijednost >= 0),
    PRIMARY KEY (tim_id, sponzor_id),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (sponzor_id) REFERENCES sponzor(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 12. OSOBLJE

CREATE TABLE osoblje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    ime VARCHAR(100),
    prezime VARCHAR(100),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 13. ULOGA OSOBLJA

CREATE TABLE uloga_osoblja (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL
);

-- 14. ZADUŽENJE

CREATE TABLE zaduzjenje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    osoblje_id INT NOT NULL,
    utrka_id INT NOT NULL,
    opis TEXT,
    FOREIGN KEY (osoblje_id) REFERENCES osoblje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (utrka_id) REFERENCES utrka(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- 15. TROŠAK TIMA

CREATE TABLE trosak_tima (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    godina YEAR NOT NULL,
    kategorija VARCHAR(100),
    iznos DECIMAL(15,2) CHECK (iznos >= 0),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



