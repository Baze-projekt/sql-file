#DROP DATABASE formula;
CREATE DATABASE formula;

USE formula;


CREATE TABLE tim (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL UNIQUE,
    vlasnik VARCHAR(100),
    baza VARCHAR(100),
	drzava VARCHAR(50) NOT NULL,
    budzet DECIMAL(15,2) NOT NULL DEFAULT 0
);


CREATE TABLE bolid (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    model VARCHAR(100) NOT NULL,
    godina INT NOT NULL,
    motor VARCHAR(100),
    sasija VARCHAR(100),
    stanje VARCHAR(30) DEFAULT 'Ispravan',
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


CREATE TABLE vozac (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    ime VARCHAR(100) NOT NULL,
    prezime VARCHAR(100) NOT NULL,
    broj INT NOT NULL,
    nacionalnost VARCHAR(100),
    datum_rodjenja DATE,
    slika LONGBLOB,
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT uniq_broj_tim UNIQUE(tim_id, broj)
);

CREATE TABLE vozac_bolid (
	id INT AUTO_INCREMENT PRIMARY KEY,
	bolid_id INT NOT NULL,
    vozac_id INT NOT NULL,
	FOREIGN KEY (bolid_id) REFERENCES bolid(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
	FOREIGN KEY (vozac_id) REFERENCES vozac(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



CREATE TABLE staza (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL UNIQUE,
    drzava VARCHAR(100),
    duljina_km DECIMAL(5,2),
    broj_krugova INT CHECK (broj_krugova > 0)
);

CREATE TABLE sezona (
    id INT PRIMARY KEY AUTO_INCREMENT,
    naziv VARCHAR(100) NOT NULL,
    godina YEAR NOT NULL,
    organizator VARCHAR(100)
);




CREATE TABLE utrka (
    id INT AUTO_INCREMENT PRIMARY KEY,
    staza_id INT NOT NULL,
    sezona_id INT NOT NULL,
    datum DATE,
    FOREIGN KEY (staza_id) REFERENCES staza(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
	FOREIGN KEY (sezona_id) REFERENCES sezona(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
	
);

drop table sudjelovanje;
CREATE TABLE sudjelovanje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    utrka_id INT NOT NULL,
    vozac_bolid_id INT NOT NULL,
    FOREIGN KEY (utrka_id) REFERENCES utrka(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (vozac_bolid_id) REFERENCES vozac_bolid(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT uniq_vozac UNIQUE(utrka_id, vozac_bolid_id)
);



CREATE TABLE rezultat (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    pozicija INT CHECK (pozicija > 0),
    bodovi INT CHECK (bodovi >= 0),
    vrijeme TIME,
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



CREATE TABLE strategija (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    broj_ulazaka_boks INT CHECK (broj_ulazaka_boks >= 0),
    tipovi_guma VARCHAR(100),
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



CREATE TABLE kazna (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sudjelovanje_id INT NOT NULL,
    opis TEXT,
    tip_kazne VARCHAR(100),
    sekunde DECIMAL(4,1) CHECK (sekunde >= 0),
    FOREIGN KEY (sudjelovanje_id) REFERENCES sudjelovanje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE TABLE poredak (
	id INT AUTO_INCREMENT PRIMARY KEY,
	vozac_id INT NOT NULL,
    sezona_id INT NOT NULL,
    kazna_id INT,
	mjesto INT NOT NULL CHECK (mjesto > 0),
    bodovi INT NOT NULL DEFAULT 0,
    pobjede INT NOT NULL DEFAULT 0,
    postolja INT DEFAULT 0,
    FOREIGN KEY (vozac_id) REFERENCES vozac(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
	FOREIGN KEY (sezona_id) REFERENCES sezona(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
	FOREIGN KEY (kazna_id) REFERENCES kazna(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE TABLE sponzor (
    id INT AUTO_INCREMENT PRIMARY KEY,
    naziv VARCHAR(100) NOT NULL,
    drzava VARCHAR(50) NOT NULL,
    tip VARCHAR(100)
);



CREATE TABLE ugovor (
    tim_id INT NOT NULL,
    sponzor_id INT NOT NULL,
    godina_od YEAR,
    godina_do YEAR,
    vrijednost DECIMAL(15,2) CHECK (vrijednost >= 0),
    PRIMARY KEY (tim_id, sponzor_id),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (sponzor_id) REFERENCES sponzor(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



CREATE TABLE osoblje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    ime VARCHAR(100),
    prezime VARCHAR(100),
    uloga VARCHAR(100) NOT NULL,
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


CREATE TABLE zaduzenje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    osoblje_id INT NOT NULL,
    utrka_id INT NOT NULL,
    opis TEXT,
    FOREIGN KEY (osoblje_id) REFERENCES osoblje(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (utrka_id) REFERENCES utrka(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



CREATE TABLE trosak_tima (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tim_id INT NOT NULL,
    godina YEAR NOT NULL,
    kategorija VARCHAR(100),
    iznos DECIMAL(15,2) CHECK (iznos >= 0),
    FOREIGN KEY (tim_id) REFERENCES tim(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



