SET id_kazna = @kazna_id,
    bodovi = bodovi - 5
WHERE id_vozac = (
    SELECT vb.id_vozac
    FROM sudjelovanje s
    JOIN vozac_bolid vb ON s.id_vozac_bolid = vb.id
    WHERE s.id = 11
)
AND id_sezona = 1;

COMMIT;

