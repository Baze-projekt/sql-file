START TRANSACTION;

INSERT INTO kazna (id_sudjelovanje, opis, tip_kazne, sekunde)
VALUES (11, 'Opasna vožnja', 'Time Penalty', 10.0);

SET @kazna_id = LAST_INSERT_ID();

